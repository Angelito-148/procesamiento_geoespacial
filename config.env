# archivo: config.env

# TODO: identificador del dataset en Kaggle: "dueño/nombre"
KAGGLE_DATASET=utkarshx27/crimes-2001-to-present

# Patrón de los CSV dentro de /data/raw después de descomprimir
CSV_GLOB=/data/raw/*.csv

# TODO: nombres EXACTOS de las columnas en el CSV
LAT_COL=Latitude
LON_COL=Longitude
TIME_COL=Date

# TODO: formato de la fecha. Ej. "01/05/2024 10:30:00 PM" -> %m/%d/%Y %I:%M:%S %p
# Ej. "2024-01-05 22:30:00" -> %Y-%m-%d %H:%M:%S . Vacío = inferir (más lento).
TIME_FORMAT=%m/%d/%Y %I:%M:%S %p

# TODO: columnas extra que quieras conservar, separadas por coma (ej. Primary Type,District)
KEEP_COLS=Case Number, Primary Type, Location Description

# TODO: caja geográfica válida minLon,minLat,maxLon,maxLat (vacío = no filtrar)
# Ej. Chicago: -88.0,41.6,-87.5,42.1
BBOX=-88.0,41.6,-87.5,42.1

# Número de particiones (~64 MB c/u) a procesar. Vacío = todo el dataset.
# Para pruebas usar 2. Para la entrega, el total o al menos 1 millón de registros.
MAX_PARTITIONS=2